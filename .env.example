# The hosting provider supplies PORT automatically. Do not set it manually.
PORT=3000
NODE_ENV=production

# Telegram BotFather token. Keep this value private.
TELEGRAM_BOT_TOKEN=

# Username without the leading @.
BOT_USERNAME=Annebellasmsbot

# Optional public URL used in Telegram web-panel links. Railway can also
# provide RAILWAY_PUBLIC_DOMAIN automatically.
PUBLIC_APP_URL=

# Optional: fixed secret for mini-app license links. If empty, bot token/admin password is used.
MINI_APP_LICENSE_SECRET=

# Password for the admin panel at /admin/login.
ADMIN_PASSWORD=

# Owner/admin Telegram numeric chat ID for credit payment approvals.
OWNER_CHAT_ID=8210676512

# PostgreSQL connection string. Required by the database package.
DATABASE_URL=

# Optional Replit demo fallback. Do not commit a real connection string.
NEON_DATABASE_URL=

# Optional live SMS log group and buttons.
SMS_LOG_GROUP_ID=-1002847599431
SMS_LOG_GET_NUMBER_URL=https://t.me/Annebellasmsbot?start=promo

# Optional structured logging level: trace, debug, info, warn, error, or fatal.
LOG_LEVEL=info